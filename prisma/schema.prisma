generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  members     Member[]
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  gender      Gender?
  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id])
  roomId      Int?
  room        Room?    @relation(fields: [roomId], references: [id])
  createdAt   DateTime @default(now())
  isLeader    Boolean  @default(false)
  quizScore   Int      @default(0)
  quizTimeMs  Int      @default(0)
  answers     Answer[]
}

// Phong ngu: moi phong chi danh cho 1 gioi tinh (nam o voi nam, nu o voi nu),
// so nguoi toi da moi phong do admin tu dat (2 = ghep cap doi).
model Room {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  gender    Gender
  capacity  Int      @default(2)
  note      String?
  createdAt DateTime @default(now())
  members   Member[]
}

model Setting {
  key   String  @id
  value String?
}

model Question {
  id           Int      @id @default(autoincrement())
  order        Int      @unique
  text         String
  options      Json
  correctIndex Int
  createdAt    DateTime @default(now())
  answers      Answer[]
}

model Answer {
  id            Int      @id @default(autoincrement())
  memberId      Int
  member        Member   @relation(fields: [memberId], references: [id])
  questionId    Int
  question      Question @relation(fields: [questionId], references: [id])
  selectedIndex Int
  correct       Boolean
  timeMs        Int
  createdAt     DateTime @default(now())

  @@unique([memberId, questionId])
}
